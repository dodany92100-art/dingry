# Stripe Checkout (serveur uniquement — ne pas préfixer NEXT_PUBLIC_)
# Dashboard Stripe → Paramètres → Moyens de paiement : activer Cartes, PayPal, Apple Pay
# Apple Pay : enregistrer ton domaine (dingry.fr, etc.) dans Stripe → Apple Pay
STRIPE_SECRET_KEY=sk_test_...

# CRM admin — Google Authenticator (secret Base32, à coller dans Vercel)
# En prod : configure le compte dans l’app avec ce secret (jamais affiché sur /admin).
# Le QR d’enrôlement n’est servi qu’en développement (npm run dev).
ADMIN_TOTP_SECRET=

# Vercel Blob (upload / suppression des images produits)
# Dashboard Vercel → Storage → Blob → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
