# PayPal — ID client public (boutons) et secret serveur (création + capture).
# PAYPAL_ENV=sandbox pour les clés de test, live (ou absent) pour la production.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# ID du webhook PayPal (Dashboard → Apps → Webhooks). URL : https://DOMAINE/api/paypal/webhook
# Événement : PAYMENT.CAPTURE.COMPLETED. Sans cet ID, la notification est refusée.
PAYPAL_WEBHOOK_ID=

# Alertes ops (Resend) — paiement sans commande, brouillon expiré, remboursement PayPal
RESEND_API_KEY=
OPS_ALERT_FROM=DINGRY Ops <onboarding@resend.dev>
OPS_ALERT_EMAIL=

# Cloudflare Turnstile — clé site publique (widget) et clé secrète (serveur uniquement)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Test widget sur fiche t-shirt (modale boutique) — `1` pour afficher, retirer après diagnostic
# NEXT_PUBLIC_DINGRY_TURNSTILE_PRODUCT_TEST=1
# Optionnel : action attendue (défaut checkout, aligné sur TurnstileWidget)
# TURNSTILE_EXPECTED_ACTION=checkout
# Hostname(s) Turnstile siteverify, séparés par des virgules (obligatoire en prod)
TURNSTILE_EXPECTED_HOSTNAME=dingry.com,www.dingry.com
# Preview : suffixe hôte autorisé si VERCEL_URL change (ex. -days-projects-36e5dc27.vercel.app)
# TURNSTILE_PREVIEW_HOST_SUFFIX=

# Upstash Redis — checkout (5 req / 10 s / IP) et tentatives de login admin
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron réconciliation stock (POST ou GET Vercel Cron) — Bearer obligatoire en prod (≥ 32 caractères)
CRON_SECRET=

# Préfixe clés Redis stock (prod : dingry: — tests Lua : test:)
# STOCK_KEY_PREFIX=dingry:
# Seed Redis depuis le catalogue : npm run seed-stock (voir scripts/seed-stock.ts)

# Supabase — CRM unifié : produits + lookbook_slides + shop_banners (service role serveur uniquement)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Vitrine catalogue sans seed statique : DINGRY_CRM_SOURCE=1
# SKIP_ENV_VALIDATION=1  # urgence uniquement — désactive le contrôle au build
# Bucket images (défaut : dgry-images, repli « dgry images »)
# SUPABASE_IMAGES_BUCKET=dgry-images

# Accueil : absent = teaser jusqu’au jeudi 20h (lib/dingry-teaser-opening.ts), puis boutique
# DINGRY_PUBLIC_HOME=shop          # forcer la boutique en local
# DINGRY_PUBLIC_HOME=construction  # page compteur simple (sans e-mail)
# DINGRY_PUBLIC_HOME=teaser
# NEXT_PUBLIC_DINGRY_PUBLIC_HOME=teaser   # même valeur pour Alto (retour boutique CRM)
#
# Gate teaser (défaut actif) : /websitedx, /checkout, /api/catalog, /api/checkout, lookbook, bannière
# nécessitent le cookie admin. Désactivation explicite au lancement public : DINGRY_TEASER_GATE=off
# DINGRY_TEASER_GATE=off

# Tests d’intégration Lua optionnels (vitest) — ne pas utiliser la base prod
# UPSTASH_TEST_URL=
# UPSTASH_TEST_TOKEN=

# Secret HMAC des cookies admin (≥ 32 car. Base32 ou hex). Obligatoire en prod — distinct de ADMIN_TOTP_SECRET.
ADMIN_SESSION_SECRET=

# CRM admin — Google Authenticator (secret Base32, à coller dans Vercel)
# Au premier login, 8 codes de secours s’affichent une seule fois.
# En prod : configure le compte dans l’app avec ce secret (jamais affiché sur /admin).
# Le QR d’enrôlement n’est servi qu’en développement (npm run dev).
ADMIN_TOTP_SECRET=

# CDN images (CSP + next/image) — hostname seul, sans https://
DINGRY_IMG_HOSTS=pub-5c13c59abc20442390a5eee5cb7034b0.r2.dev
# NEXT_PUBLIC_MEDIA_CDN_HOST=cdn.dingry.com

# Cloudflare R2 — uploads CRM admin (produits, lookbook, bannière → `image_url` Supabase)
R2_PUBLIC_BASE_URL=https://pub-5c13c59abc20442390a5eee5cb7034b0.r2.dev
R2_ACCOUNT_ID=
R2_BUCKET_NAME=dingrybuckets
# Token R2 « S3 API » (32 + 64 car.) — pas le token API Cloudflare global ni l’URL publique
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optionnel : endpoint S3 custom (défaut https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_S3_ENDPOINT=

# Snapshot JSON commandes / lookbook (volume persistant côté serveur)
# ADMIN_STORE_SNAPSHOT_PATH=/var/lib/dingry/store.json
# ADMIN_BACKUP_CODES_PATH=/var/lib/dingry/backup-codes.json
